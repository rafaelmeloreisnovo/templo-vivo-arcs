{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:templo-vivo-arcs:interaction-feedback:v1",
  "title": "Interaction Feedback Evolution Record V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["interaction_id","observed_at","source","confidence","urgency","delta","gaps","next","claim_allowed"],
  "properties": {
    "interaction_id": {"type":"string","minLength":1},
    "observed_at": {"type":"string","format":"date-time"},
    "source_time": {"type":["string","null"]},
    "persisted_at": {"type":["string","null"],"format":"date-time"},
    "source": {
      "type":"object",
      "required":["provider","identity"],
      "properties": {
        "provider":{"type":"string"},
        "identity":{"type":"string"},
        "ref":{"type":["string","null"]},
        "path":{"type":["string","null"]},
        "digest":{"type":["string","null"]}
      },
      "additionalProperties":false
    },
    "confidence":{"enum":["HIGH","MEDIUM","LOW","TOKEN_VAZIO"]},
    "urgency":{"enum":["P0","P1","P2","P3"]},
    "authority":{"type":["string","null"]},
    "epistemic_state":{"type":["string","null"]},
    "delta":{"type":"array","items":{"type":"string"}},
    "gaps":{"type":"array","items":{"type":"string"}},
    "contradictions":{"type":"array","items":{"type":"string"}},
    "next":{"type":"array","items":{"type":"string"},"minItems":1},
    "receipt":{"type":["string","null"]},
    "supersedes":{"type":"array","items":{"type":"string"}},
    "claim_allowed":{"const":false}
  }
}
